rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Admin por custom claim en el ID token (role: 'admin' | 'superadmin').
    // Se fija con el Admin SDK (scripts/set-role.mjs); no desde el cliente.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.role in ['admin', 'superadmin'];
    }

    // Envío de emails (extensión Trigger Email).
    match /mail/{mailId} {
      allow create: if true;
    }

    // Solicitudes de presupuesto: alta pública; solo admin lee/gestiona.
    match /refcon_budget/{budgetId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    match /refcon_contact/{contactId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ---- Agenda de citas ----

    // Config: lectura pública (la landing la necesita), escritura solo admin.
    match /refcon_agenda_config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Contadores de aforo por día: SIN datos personales. Lectura pública y
    // create/update público (la reserva los incrementa por transacción).
    match /refcon_agenda_slots/{dateKey} {
      allow read: if true;
      allow create, update: if true;
    }

    // Citas con datos personales: alta pública (reserva), pero solo el admin
    // autenticado puede leerlas y gestionarlas.
    match /refcon_appointments/{appointmentId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
