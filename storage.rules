rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Lectura pública de los assets del sitio (imágenes servidas por URL).
    // Escritura solo para usuarios autenticados (la web no sube nada de forma
    // anónima; las subidas puntuales de assets las hace el admin).
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
